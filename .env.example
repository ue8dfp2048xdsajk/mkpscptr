# ── Clerk ────────────────────────────────────────────────────────────────────
# Publishable key — safe to expose in frontend HTML (already in index.html)
# CLERK_PUBLISHABLE_KEY=pk_live_...

# Secret key — NEVER commit this. Add it in the Vercel dashboard under
# Project → Settings → Environment Variables.
CLERK_SECRET_KEY=sk_live_...

# ── Deployment URL ───────────────────────────────────────────────────────────
# The public root URL of this deployment, without a trailing slash.
# Used by the Stripe webhook handler to call POST /api/set-plan via HTTP.
# If this is missing, every webhook event will return 500 and no user will be
# upgraded after payment.  For Vercel, set it to your production domain, e.g.:
#   BASE_URL=https://mockupscripter.com
# Add it in the Vercel dashboard under Project → Settings → Environment Variables.
BASE_URL=https://your-domain.vercel.app

# ── Internal API security ────────────────────────────────────────────────────
# A random string you choose (e.g. openssl rand -hex 32).
# The Stripe webhook handler sends this in every call to POST /api/set-plan
# so the function can verify the request is legitimate.
# Add it in Vercel dashboard under Project → Settings → Environment Variables.
SET_PLAN_SECRET=replace_with_a_long_random_string

# ── Stripe ───────────────────────────────────────────────────────────────────
# Secret key — from Stripe dashboard → Developers → API keys.
# Use sk_test_... in test mode, sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from Stripe dashboard → Developers → Webhooks.
# Required by the webhook handler to verify event signatures.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create Products + Prices in the Stripe dashboard, then paste
# the price_... IDs here.  All six must be set before checkout will work.
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_STARTER_LIFETIME=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_PRO_LIFETIME=price_...

# ── Rate limiter (persistent across cold starts) ──────────────────────────────
# Without these the rate limiter falls back to an in-memory store that resets
# on every cold start.  Create a free Upstash Redis database at
# https://console.upstash.com, then copy the REST URL and token here.
# Add both in the Vercel dashboard under Project → Settings → Environment Variables.
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN
