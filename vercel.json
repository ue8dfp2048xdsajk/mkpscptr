{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --prefix api",
  "outputDirectory": ".",
  "routes": [
    { "src": "/api/projects/([^/]+)", "dest": "/api/projects/[id]?id=$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" },
    { "handle": "error" },
    { "status": 404, "src": "/(.*)", "dest": "/404.html" }
  ]
}
